<h2>Search Books</h2>
<form action="/books" method="get">
  <div>
    <label>Title</label>
    <input type="text" name="title" value="<%= search.title %>">
  </div>
  <div>
    <label>Published After</label>
    <input type="date" name="publishedAfter" value="<%= search.publishedAfter %>">
  </div>
  <div>
    <label>Published Before</label>
    <input type="date" name="publishedBefore" value="<%= search.publishedBefore %>">
  </div>
  <button type="submit">Search</button>
</form>
<div>
<% books.forEach(book => { %>
  <img height="150" width="100" src="<%= book.coverImageFile %>">
<%})%>
</div>